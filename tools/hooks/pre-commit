#!/bin/sh
# Refuses a commit that would take committed lines out of src/patch-notes.md or CLAUDE.md, or put in an older build of
# the patch notes page (a stale whole-file copy from another thread). Installed with: git config core.hooksPath tools/hooks
# ALLOW_NOTES_REMOVAL=1 lets a deliberate removal through. See tools/check_stale.py.
command -v python >/dev/null 2>&1 && PY=python || PY=python3
exec "$PY" "$(git rev-parse --show-toplevel)/tools/check_stale.py" --staged
